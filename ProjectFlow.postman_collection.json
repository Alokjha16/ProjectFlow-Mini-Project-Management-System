{
  "info": {
    "name": "ProjectFlow API",
    "description": "Mini Project Management System - Complete API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:5000" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/health"
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/projects",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"E-commerce Platform\",\n  \"description\": \"A full-stack online shopping system\"\n}"
            }
          }
        },
        {
          "name": "Get All Projects",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/projects?page=1&limit=10",
              "host": ["{{BASE_URL}}"],
              "path": ["projects"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Project by ID",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/projects/1"
          }
        },
        {
          "name": "Delete Project",
          "request": {
            "method": "DELETE",
            "url": "{{BASE_URL}}/projects/1"
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/projects/1/tasks",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Design homepage UI\",\n  \"description\": \"Create wireframes and high-fidelity mockups\",\n  \"status\": \"todo\",\n  \"priority\": \"high\",\n  \"due_date\": \"2024-02-15\"\n}"
            }
          }
        },
        {
          "name": "Get Tasks (with filters)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/projects/1/tasks?page=1&limit=10&status=todo&sort_by=due_date&order=asc",
              "host": ["{{BASE_URL}}"],
              "path": ["projects", "1", "tasks"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "todo", "description": "Filter: todo | in-progress | done" },
                { "key": "sort_by", "value": "due_date", "description": "Sort: due_date | created_at | priority" },
                { "key": "order", "value": "asc", "description": "Order: asc | desc" }
              ]
            }
          }
        },
        {
          "name": "Get Tasks (no filter)",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/projects/1/tasks"
          }
        },
        {
          "name": "Update Task",
          "request": {
            "method": "PUT",
            "url": "{{BASE_URL}}/tasks/1",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in-progress\",\n  \"priority\": \"high\",\n  \"due_date\": \"2024-02-20\"\n}"
            }
          }
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "url": "{{BASE_URL}}/tasks/1"
          }
        }
      ]
    },
    {
      "name": "Validation Tests",
      "item": [
        {
          "name": "Create Project - Missing Name (422)",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/projects",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"description\": \"No name provided\"}" }
          }
        },
        {
          "name": "Create Task - Invalid Status (422)",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/projects/1/tasks",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"title\": \"Test\", \"status\": \"invalid-status\"}" }
          }
        },
        {
          "name": "Get Project - Not Found (404)",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/projects/99999"
          }
        }
      ]
    }
  ]
}
